#! /bin/sh

set -e

case "$1" in
start)
    echo -n "Starting rayhunter: "
    # Below line may be replaced by the installer with device-specific startup commands, such as mounting the SD card.
    #RAYHUNTER-PRESTART
    start-stop-daemon -S -b --make-pidfile --pidfile /tmp/rayhunter.pid \
    --startas /bin/sh -- -c "RUST_LOG=info exec /data/rayhunter/rayhunter-daemon /data/rayhunter/config.toml > /data/rayhunter/rayhunter.log 2>&1"
    echo "done"
    ;;
  stop)
    echo -n "Stopping rayhunter: "
    start-stop-daemon -K -p /tmp/rayhunter.pid
    # -K only sends the signal. Wait for the daemon to exit (it closes the
    # current recording on SIGTERM) so that a following start can bind its
    # port. busybox start-stop-daemon has no --retry, so poll with -t.
    i=0
    while start-stop-daemon -K -t -q -p /tmp/rayhunter.pid 2>/dev/null; do
        if [ "$i" -ge 15 ]; then
            echo -n "still running after ${i}s, killing: "
            start-stop-daemon -K -q -s KILL -p /tmp/rayhunter.pid || true
            sleep 1
            break
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "done"
    ;;
  restart)
    # stop fails when nothing is running; start anyway
    $0 stop || true
    $0 start
    ;;
  *)
    echo "Usage rayhunter_daemon { start | stop | restart }" >&2
    exit 1
    ;;
esac

exit 0
